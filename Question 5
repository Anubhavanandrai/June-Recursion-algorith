
public class Main
{
    public static int Sum(int n)
    {
        if(n==0)
        {
           return 0;
        }
        int digit = n%10;
        int x=n/10;
      return digit+Sum(x);   
    }
    
    public static void main(String[] args) 
    {
     int value=Sum(1044); 
     System.out.println(value);
    }
}
