
public class Main
{
    public static String Reverse(String s)
    {
       if(s.length()==1)
       {
         return s;
       }
       
       return Reverse(s.substring(1))+s.charAt(0);
    }
    
    public static void main(String[] args) 
    {
     String value=Reverse("Anub"); 
     System.out.println(value);
    }
}
