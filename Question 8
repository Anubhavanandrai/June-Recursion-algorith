public class Main {

    public static boolean maxArray(int[] arr, int start, int end) {

        // Base case
        if (start == end && arr[start]>0) {
            return true;
        }
          if (start == end && arr[start]<0) {
            return false;
        }

        int mid = (start + end) / 2;

        // Recursive calls
       boolean x= maxArray(arr, start, mid);
       boolean y =  maxArray(arr, mid + 1, end);
       
       if (x &&y ==true)
       {
         return true;
         }

         return false;
         

    }

    public static void main(String[] args) {

        int[] arr = {3, 7, -5, 1, 8};

        boolean result = maxArray(arr, 0, arr.length - 1);

        System.out.println("Maximum = " + result);
    }
}
